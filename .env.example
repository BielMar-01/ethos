# Copie para .env e preencha. Nunca commite o .env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Chave administrativa: SOMENTE no servidor, nunca no front-end.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# String de conexão Postgres (Supabase > Connect). Use o pooler se a rede não tiver IPv6.
DATABASE_URL=

# URL pública do app (links de convite e de recuperação de senha). Dev: front em :5173.
APP_URL=http://localhost:5173

# --- Produção na Vercel (Settings > Environment Variables) ---
# DATABASE_URL: use o "Transaction pooler" do Supabase (porta 6543); conexões diretas esgotam em serverless.
# APP_URL: https://seu-dominio (também em Supabase > Authentication > URL Configuration > Redirect URLs).
# CRON_SECRET: texto longo e aleatório; a Vercel o envia ao Cron dos lembretes. Sem ele a rota fica desligada.
CRON_SECRET=
# Opcional: máximo de conexões por instância (padrão 3 na Vercel, 10 fora dela).
DB_POOL_MAX=

# --- Segurança de conta ---
# 1 = o cadastro público só abre a sessão depois do clique no link enviado ao e-mail (o login recusa e-mail não confirmado).
# Exige SMTP próprio no Supabase (o padrão envia pouquíssimos e-mails por hora). Sem a variável, o cadastro entra direto.
REQUIRE_EMAIL_VERIFICATION=
# O 2FA (TOTP) guarda o segredo cifrado com INTEGRATIONS_SECRET (abaixo): sem ela, a tela de perfil avisa que o 2FA está indisponível.

# Quem recebe o e-mail quando há uma enxurrada de erros 5xx (10 em 10 min). Separe por vírgula. Vazio = sem aviso.
ERROR_ALERT_EMAILS=

# --- Leitura automática de documentos (Cadastro por documento) ---
# Sem esta chave a tela avisa que a função está desligada. Crie em console.anthropic.com. SOMENTE no servidor.
ANTHROPIC_API_KEY=
# Opcional: modelo usado na leitura (padrão claude-opus-5-5). Ex.: claude-sonnet-5-5 para custar menos.
EXTRACT_MODEL=
# Opcional: máximo de leituras por hora por organização (padrão 30).
EXTRACT_RATE_MAX=

# --- Integrações (Asaas, IA por organização, webhooks) ---
# Chave que CIFRA os segredos guardados no banco (AES-256-GCM). 32+ caracteres aleatórios, SÓ no servidor.
# Sem ela a tela Integrações avisa e não guarda nenhuma chave. NÃO troque depois de salvar chaves (elas ficariam ilegíveis).
INTEGRATIONS_SECRET=

# --- E-mail, push, WhatsApp, login social (veja docs/CONFIGURACAO-PENDENTES.md) ---
# E-mail do Ethos (Resend). EMAIL_FROM precisa ser de um domínio verificado no Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Notificação push (npx web-push generate-vapid-keys). VAPID_SUBJECT: mailto:contato@seu-dominio
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# WhatsApp oficial (Meta Cloud API): só com modelo aprovado e consentimento da pessoa.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=pt_BR
# Botões de login social (também configure o provedor no Supabase): google, azure ou google,azure
OAUTH_PROVIDERS=
# Dias até anonimizar a auditoria de contas encerradas (padrão 1825 = 5 anos).
AUDIT_ANON_AFTER_DAYS=
# Backup lógico (npm run db:backup): conexão direta ou Session pooler (porta 5432).
BACKUP_DATABASE_URL=
